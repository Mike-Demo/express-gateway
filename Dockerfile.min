# TEMPORARY bisect image (branch ce-debug only): stock node:22-alpine with an
# inline HTTP server. No npm install, no copied files.
FROM node:22-alpine
EXPOSE 8080
CMD ["node", "-e", "require('http').createServer((q,r)=>{r.writeHead(200,{'Content-Type':'text/plain'});r.end('min ok')}).listen(8080)"]
